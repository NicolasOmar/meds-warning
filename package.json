{
  "name": "meds-warning",
  "version": "2.1.3",
  "description": "A web system to help users manage and track their medication expiration dates and remind them to renew them",
  "author": "Nicolás Omar González Passerino",
  "keywords": [],
  "license": "GPL-3.0-only",
  "private": true,
  "homepage": "https://meds-warning.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasOmar/meds-warning.git"
  },
  "bugs": {
    "url": "https://github.com/NicolasOmar/meds-warning/issues"
  },
  "scripts": {
    "start": "next dev",
    "start:prod": "npm run build && next start",
    "app:compile": "tsc -b",
    "build": "npm run db:compile && npm run app:compile && next build",
    "db:compile": "prisma generate --config configs/prisma.config.ts",
    "db:migrate": "npm run db:compile && prisma migrate dev --config configs/prisma.config.ts",
    "db:seed": "prisma db seed --config configs/prisma.config.ts",
    "db:migrate:diff": "prisma migrate diff --config configs/prisma.config.ts",
    "db:push:dev": "prisma db execute --config configs/prisma.config.ts",
    "db:push:prod": "prisma migrate deploy --config configs/prisma.config.ts",
    "test": "vitest --config configs/vitest.config.ts",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint --config configs/eslint.config.mjs --max-warnings 0",
    "format:base": "prettier --config configs/.prettierrc {actions,prisma,shared}/**/*.ts {app,components}/**/*.tsx",
    "format": "npm run format:base -- --write",
    "format:check": "npm run format:base -- --check",
    "lint-staged": "lint-staged -v",
    "setup": "npm ci && husky",
    "update": "ncu -i --format group --peer --doctor --doctorTest 'npm run check:project'",
    "check:project": "npm run format:check && npm run lint && npm run build && npm run test:coverage",
    "add:component": "bash component.sh",
    "publish": "semantic-release --extends ./configs/release.config.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.577.0",
    "mailgun.js": "^12.7.1",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10",
    "eslint-config-next": "16.2.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^19.6.5",
    "prettier": "^3.8.1",
    "prisma": "^7.5.0",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "(actions|app|components|prisma|shared)/**/*.(ts|tsx)": [
      "prettier --config configs/.prettierrc --write",
      "eslint --config configs/eslint.config.mjs --max-warnings 0"
    ]
  }
}
