{
  "name": "meds-warning",
  "version": "1.0.0",
  "description": "A web system to help users manage and track their medication expiration dates and remind them to renew them",
  "author": "Nicolás Omar González Passerino",
  "license": "GPL-3.0-only",
  "private": true,
  "homepage": "https://meds-warning-j2hqm1kak.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasOmar/meds-warning.git"
  },
  "bugs": {
    "url": "https://github.com/NicolasOmar/meds-warning/issues"
  },
  "scripts": {
    "start": "next dev",
    "start:prod": "npm run build && next start",
    "add:component": "bash component.sh",
    "compile": "tsc -b",
    "build": "npm run compile && next build",
    "build:ci": "npm run db:build && npm run build",
    "test": "vitest",
    "test:ci": "npm test -- --coverage",
    "lint": "eslint --max-warnings 0",
    "prettier": "prettier {actions,lib,prisma}/**/*.ts {app,components}/**/*.tsx",
    "prettier:check": "npm run prettier -- --check",
    "prettier:fix": "npm run prettier -- --write",
    "lint-staged": "lint-staged -v",
    "update": "ncu -i --format group --doctor --doctorTest 'npm run check:project'",
    "check:project": "npm run prettier:check && npm run lint && npm run build:ci && npm run test:ci",
    "db:sync": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:build": "npm run db:sync && npm run db:migrate",
    "db:seed": "prisma db seed",
    "db:migrate:diff": "prisma migrate diff",
    "db:push:dev": "prisma db execute",
    "db:push:prod": "prisma migrate deploy",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.0",
    "react-dom": "19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.2.7",
    "npm-check-updates": "^19.2.0",
    "prettier": "^3.7.4",
    "prisma": "^7.2.0",
    "prisma-zod-generator": "^2.1.2",
    "semantic-release": "^24.2.9",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "(actions|app|components|lib|prisma)/**/*.(ts|tsx)": [
      "prettier --write",
      "eslint"
    ]
  }
}
